# The stock BOINC server, built from the upstream sources of this repository
# (everything outside cloud/), for the differential test. See
# cloud/docs/compatibility.md and stock.sh, which stages the build context.
#
# One image runs everything, because the feeder and the scheduler share a
# System V shared-memory segment: MariaDB, Apache with PHP, the scheduler and
# upload handler CGIs, and the feeder. Nothing is started at build time.
ARG BASE=docker.io/library/debian:bookworm-slim

FROM ${BASE} AS build
ARG BUILD_JOBS=2
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates dh-autoreconf g++ libcurl4-gnutls-dev default-libmysqlclient-dev \
      libssl-dev libzip-dev libfmt-dev nlohmann-json3-dev m4 make pkg-config \
      python3 python3-dev python3-setuptools gettext autopoint \
 && rm -rf /var/lib/apt/lists/*
# The context is the upstream tree, staged by stock.sh without cloud/ or .git.
COPY upstream/ /opt/boinc/
WORKDIR /opt/boinc
RUN ./_autosetup \
 && ./configure --enable-server --disable-client --disable-manager \
 && nice -n 19 make -j "${BUILD_JOBS}"

FROM ${BASE}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      apache2 ca-certificates curl libapache2-mod-php8.2 libcurl3-gnutls libfmt9 \
      libmariadb3 libzip4 libxml2-utils mariadb-server openssl php8.2-cli php8.2-curl \
      php8.2-gd php8.2-mbstring php8.2-mysql php8.2-xml procps python-is-python3 python3 \
      python3-mysqldb binutils \
 && a2dismod -q mpm_event && a2enmod -q mpm_prefork php8.2 cgi headers rewrite \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/boinc /opt/boinc
COPY stock/ /opt/differential/
RUN chmod 0755 /opt/differential/*.sh
ENTRYPOINT ["/opt/differential/serve.sh"]
